local function folder(): Instance?
	return ReplicatedStorage:FindFirstChild(Mech2Meshes.FolderName)
end

-- A template only counts while it holds this entry's mesh: re-imported
-- meshes (pelvis_* after the tasset split) get new ids, and the old template
-- of the same name must be replaced, not kept.
local function meshIdOf(e: Entry): string
	return string.format("%.0f", e.mesh)
end

function Mech2Meshes.template(name: string): MeshPart?
	local f = folder()
	local t = f and f:FindFirstChild(name)
	local e = Mech2Meshes.Meshes[name]
	if not (t and t:IsA("MeshPart")) then
		return nil
	end
	if e and not string.find(t.MeshId, meshIdOf(e), 1, true) then
		return nil -- stale (an older upload of this mesh)
	end
	return t
end

-- Names without a template.
function Mech2Meshes.missing(): { string }
	local out = {}
	for name in Mech2Meshes.Meshes do
		if not Mech2Meshes.template(name) then
			table.insert(out, name)
		end
	end
	table.sort(out)
	return out
end

-- The crosshatch overlay (the BRZ-01 mesh skins' SurfaceAppearance: AlphaMode
-- Overlay, ColorMap = Titan_Crosshatch_Overlay.png, black at alpha
-- 0.5 * (1 - lattice)). The mech2 OBJ UVs are 1 repeat = 4 studs like the
-- Titan meshes, so the lattice has the same pitch and runs on across
-- neighbouring panels. ReplicatedStorage.Mech2Meshes.Crosshatch, falling
-- back to ReplicatedStorage.TitanMeshes.Crosshatch.
Mech2Meshes.CrosshatchMap = "rbxassetid://133926271015331"

function Mech2Meshes.crosshatch(): SurfaceAppearance?
	for _, name in { Mech2Meshes.FolderName, "TitanMeshes" } do
		local f = ReplicatedStorage:FindFirstChild(name)
		local sa = f and f:FindFirstChild("Crosshatch")
		if sa and sa:IsA("SurfaceAppearance") then
			return sa
		end
	end
	return nil
end

function Mech2Meshes.available(): boolean
	return #Mech2Meshes.missing() == 0
end

-- Loads every missing template (parallel LoadAsset calls; yields). Returns
-- the names that still failed. Server / edit mode only.
function Mech2Meshes.ensure(): { string }
	local missing = Mech2Meshes.missing()
	local f = folder()
	if not f then
		local nf = Instance.new("Folder")
		nf.Name = Mech2Meshes.FolderName
		nf.Parent = ReplicatedStorage
		f = nf
	end
	if not f:FindFirstChild("Crosshatch") then
		-- ColorMap is plugin-only: clone the Titan one, or make it (edit mode)
		local titan = ReplicatedStorage:FindFirstChild("TitanMeshes")
		local src = titan and titan:FindFirstChild("Crosshatch")
		if src and src:IsA("SurfaceAppearance") then
			src:Clone().Parent = f
		else
			pcall(function()
				local sa = Instance.new("SurfaceAppearance")
				sa.Name = "Crosshatch"
				sa.AlphaMode = Enum.AlphaMode.Overlay;
				(sa :: any).ColorMap = Mech2Meshes.CrosshatchMap
				sa.Parent = f
			end)
		end
	end
	if #missing == 0 then
		return missing
	end
	local pending = #missing
	local done = Instance.new("BindableEvent")
	for _, name in missing do
		task.spawn(function()
			local e = Mech2Meshes.Meshes[name]
			local ok, res = pcall(InsertService.LoadAsset, InsertService, e.model)
			if ok and res then
				local mp = res:FindFirstChildWhichIsA("MeshPart", true)
				if mp then
					-- drop stale templates of this name first
					for _, old in f:GetChildren() do
						if old.Name == name then
							old:Destroy()
						end
					end
					mp.Name = name
					mp.Anchored = true
					mp.CanCollide = false
					mp.CanTouch = false
					mp.CanQuery = false
					mp.Parent = f
				end
				res:Destroy()
			else
				warn("[Mech2Meshes] LoadAsset " .. name .. " (" .. e.model .. ") failed: " .. tostring(res))
			end
			pending -= 1
			if pending == 0 then
				done:Fire()
			end
		end)
	end
	if pending > 0 then
		done.Event:Wait()
	end
	done:Destroy()
	return Mech2Meshes.missing()
end

return Mech2Meshes
